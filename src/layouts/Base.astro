---
import '../styles/global.css';
import { sharePhoto } from '../lib/photo';
interface App { name: string; manifest: string; icon: string; shareImage: string; }
interface Props { title: string; description: string; jsonLd?: object; app?: App; }
const { title, description, jsonLd, app } = Astro.props;
const share = app
  ? { src: app.shareImage, type: 'image/png', size: 512 }
  : sharePhoto && { src: sharePhoto.src, type: 'image/jpeg', size: 800 };
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href={app?.icon ?? '/apple-touch-icon.png'} />
    {app && (
      <>
        <link rel="manifest" href={app.manifest} />
        <meta name="apple-mobile-web-app-title" content={app.name} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {share && (
      <>
        <meta property="og:image" content={new URL(share.src, Astro.site)} />
        <meta property="og:image:type" content={share.type} />
        <meta property="og:image:width" content={String(share.size)} />
        <meta property="og:image:height" content={String(share.size)} />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:image" content={new URL(share.src, Astro.site)} />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#eef1f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2229" media="(prefers-color-scheme: dark)" />
    <meta name="google-site-verification" content="K4jRFVE3wXabpaNjFdNlwVQwxQDWO4JyPzRnD0_dwrQ" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <!-- GoatCounter analytics, skipped when Do Not Track is on -->
    <script is:inline>
      window.goatcounter = { no_onload: 'doNotTrack' in navigator && navigator.doNotTrack === '1' };
    </script>
    <script is:inline data-goatcounter="https://ismailguderer.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
