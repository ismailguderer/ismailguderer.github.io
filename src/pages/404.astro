---
import Base from '../layouts/Base.astro';
import { cv } from '../lib/cv';
import { squigglePath } from '../lib/squiggle';
const d = squigglePath(1200, 140, 23);
const home = import.meta.env.BASE_URL;
---
<Base title={`Page not found | ${cv.person.name}`} description={cv.site.description}>
  <main id="main" class="nf">
    <div class="trace" aria-hidden="true">
      <svg viewBox="0 0 1200 140" preserveAspectRatio="none">
        <path d={d} vector-effect="non-scaling-stroke" />
      </svg>
    </div>
    <h1>404</h1>
    <p class="lead">This page does not exist. The read ended here.</p>
    <p><a href={home}>Go to {cv.person.name}'s homepage</a></p>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh; min-height: 100dvh;
    max-width: 46rem; margin: 0 auto; padding: var(--s8) var(--s4);
    display: flex; flex-direction: column; justify-content: center;
  }
  .trace { height: 90px; margin-bottom: var(--s6); }
  .trace svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .trace path { fill: none; stroke: var(--trace); stroke-width: 1.25; stroke-linejoin: round; }
  h1 { font-size: clamp(4rem, 14vw, 7rem); font-weight: 300; letter-spacing: -0.04em; line-height: 1; }
  .lead { margin: var(--s4) 0 var(--s5); font-size: 1.25rem; color: var(--muted); }
</style>
