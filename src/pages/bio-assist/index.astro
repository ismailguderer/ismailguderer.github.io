---
import Tools from '../../layouts/Tools.astro';
import { TOOLS, GROUPS } from '@bio-assist/tools.js';
---
<Tools title="BIO-ASSIST | Wet Lab Toolkit" description="Free wet lab toolkit: molarity, dilutions, master mixes, gels, primers, cell seeding, and more." brand={false}>
  <h1 class="title"><img src="/bio-assist/icon-192.png" width="56" height="56" alt="" />BIO-ASSIST</h1>
  <p class="lead">Toolkit for everyday bench work.<br />Works offline; nothing you enter leaves your device.</p>
  <div class="install" data-install hidden>
    <button class="install-btn" type="button" data-install-button hidden>Install App</button>
    <p class="muted small" data-install-ios hidden>To install: tap Share, then Add to Home Screen.</p>
  </div>

  <div class="search">
    <label class="label" for="tool-search">Find a Tool</label>
    <input id="tool-search" type="search" autocomplete="off" placeholder="e.g. primer, gel, qPCR" aria-describedby="search-hint" />
    <p id="search-hint" class="hint muted small">Press / to search, Enter to open the first match.</p>
  </div>

  {GROUPS.map((g) => (
    <section class="group" data-group>
      <h2>{g}</h2>
      <ul class="cards">
        {TOOLS.filter((t) => t.group === g).map((t) => (
          <li data-tool data-search={`${t.name} ${t.group} ${t.description} ${t.keywords}`.toLowerCase()}>
            <a class="card" href={`/bio-assist/${t.id}/`}>
              <span class="name">{t.name}</span>
              <span class="desc">{t.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="empty muted" hidden data-empty>No tool matches your search.</p>
</Tools>

<script>
  // install: a one-tap button where the browser supports it, the Share hint on iPhone/iPad, nothing once installed
  const install = document.querySelector<HTMLElement>('[data-install]')!;
  const installBtn = document.querySelector<HTMLButtonElement>('[data-install-button]')!;
  const iosHint = document.querySelector<HTMLElement>('[data-install-ios]')!;
  const installed = matchMedia('(display-mode: standalone)').matches || (navigator as { standalone?: boolean }).standalone === true;
  const ios = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  let deferred: (Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: string }> }) | null = null;
  if (!installed && ios) { install.hidden = false; iosHint.hidden = false; }
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    if (installed) return;
    deferred = e as typeof deferred;
    install.hidden = false;
    installBtn.hidden = false;
  });
  installBtn.addEventListener('click', async () => {
    if (!deferred) return;
    await deferred.prompt();
    const { outcome } = await deferred.userChoice;
    if (outcome === 'accepted') { deferred = null; install.hidden = true; }
  });
  window.addEventListener('appinstalled', () => { install.hidden = true; });

  const input = document.getElementById('tool-search') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('[data-tool]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const filter = () => {
    const q = input.value.trim().toLowerCase();
    items.forEach((li) => { li.hidden = !!q && !li.dataset.search!.includes(q); });
    groups.forEach((g) => { g.hidden = !g.querySelector('[data-tool]:not([hidden])'); });
    empty.hidden = items.some((li) => !li.hidden);
  };
  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const first = items.find((li) => !li.hidden)?.querySelector('a');
    if (first) location.href = first.href;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== input) { e.preventDefault(); input.focus(); }
  });
</script>

<style>
  .title {
    display: flex; align-items: center; gap: var(--s4); margin-top: var(--s4);
    font-size: clamp(2.4rem, 7vw, 3.5rem); font-weight: 300; letter-spacing: -0.035em; line-height: 1;
  }
  .title img { width: 0.95em; height: 0.95em; border-radius: 0.2em; flex: none; }
  .lead { margin-top: var(--s4); color: var(--muted); max-width: 38rem; }
  .install { margin-top: var(--s4); }
  .install-btn {
    min-height: 44px; padding: 0 var(--s4); font: inherit; font-size: 0.95rem; font-weight: 600; cursor: pointer;
    color: var(--on-accent); background: var(--accent); border: 1px solid var(--accent); border-radius: var(--r);
  }
  .install-btn:hover { filter: brightness(1.08); }
  .search { margin-top: var(--s6); }
  .label { display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: var(--s2); }
  #tool-search {
    width: 100%; min-height: 48px; padding: 0 var(--s4); font: inherit; font-size: 1rem;
    color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r);
  }
  #tool-search:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .hint { margin-top: var(--s2); }
  .group { margin-top: var(--s6); }
  .group h2 { font-size: 1.05rem; padding-bottom: var(--s2); margin-bottom: var(--s3); border-bottom: 1px solid var(--line); }
  .cards { display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); grid-auto-rows: 1fr; }
  .card {
    display: block; min-height: 44px; padding: var(--s3) var(--s4); height: 100%;
    border: 1px solid var(--line); border-radius: var(--r); background: var(--surface);
  }
  .card:hover { text-decoration: none; border-color: var(--accent); }
  .name { display: block; font-weight: 600; color: var(--ink); }
  .card:hover .name { color: var(--accent); }
  .desc { display: block; font-size: 0.9rem; color: var(--muted); margin-top: 0.15rem; }
  .empty { margin-top: var(--s5); }
  [hidden] { display: none !important; }
</style>
