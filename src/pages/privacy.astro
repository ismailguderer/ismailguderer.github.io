---
import Base from '../layouts/Base.astro';
import { cv } from '../lib/cv';
const home = import.meta.env.BASE_URL;
const email = 'SXNtYWlsLkd1ZGVyZXJAbGVpYm5pei1mbGkuZGU=';
---
<Base title={`Privacy | ${cv.person.name}`} description={`Privacy notice for the website of ${cv.person.name}.`}>
  <main id="main" class="page">
    <p class="back small"><a href={home}>← {cv.person.name}</a></p>
    <h1>Privacy</h1>
    <p class="lead text">This site sets no cookies and shows no ads. Here is what happens when you visit it.</p>

    <section class="section prose">
      <h2>Hosting</h2>
      <p>
        <a href="https://pages.github.com/" target="_blank" rel="noopener">GitHub Pages</a>, run by GitHub, Inc. in the United States, hosts this site. To deliver the pages and keep them secure,
        GitHub's servers process your IP address, browser details, the requested page, and the time of the request, and
        keep them in server logs. I have no access to these logs. The legal basis is my legitimate interest in running a
        secure website (Art. 6(1)(f) GDPR). Because GitHub is a US company, your data may be transferred to the US. See
        the <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener">GitHub Privacy Statement</a>.
      </p>
    </section>

    <section class="section prose">
      <h2>Visitor Statistics</h2>
      <p>
        <a href="https://www.goatcounter.com" target="_blank" rel="noopener">GoatCounter</a> counts page views. It sets no
        cookies, does not store your IP address, and keeps only totals: page, referring site, browser, operating system,
        screen width, language, and country. To avoid counting one visitor twice, it holds a random ID in memory for up to
        eight hours and then discards it. Its servers are in Finland and Germany. The legal basis is my legitimate interest
        in knowing how the site is used (Art. 6(1)(f) GDPR). If your browser sends a Do Not Track signal, nothing is counted.
        See the <a href="https://www.goatcounter.com/privacy" target="_blank" rel="noopener">GoatCounter Privacy Policy</a>.
      </p>
    </section>

    <section class="section prose">
      <h2>Stored on Your Device</h2>
      <p>
        If you pick a light or dark theme, your browser remembers the choice in local storage. It never leaves your device,
        and you can delete it by switching back to Auto.
      </p>
    </section>

    <section class="section prose">
      <h2>Fonts and Links</h2>
      <p>
        The fonts are served from this site, so no font service learns about your visit. Links to other sites, such as
        journals or ORCID, fall under those sites' own privacy policies.
      </p>
    </section>

    <section class="section prose">
      <h2>Your Rights</h2>
      <p>
        You may ask for access to, correction, or deletion of your data, ask me to restrict its processing, or object to it.
        You may also complain to a data protection authority; in Thuringia this is the
        <a href="https://tlfdi.de" target="_blank" rel="noopener">TLfDI</a>.
      </p>
    </section>

    <section class="section prose">
      <h2>Responsible Person</h2>
      <p>{cv.person.name}, Jena, Germany.</p>
      <p>
        <button class="reveal" type="button" data-email={email}>Show Email Address</button>
        <noscript>Ismail.Guderer at leibniz-fli dot de</noscript>
      </p>
    </section>

    <p class="updated small muted">Last updated October 2026.</p>
  </main>
</Base>

<style>
  .page { max-width: 42rem; margin: 0 auto; padding: var(--s8) var(--s4) var(--s9); }
  .back { margin-bottom: var(--s7); }
  .back a { color: var(--muted); }
  h1 { font-size: clamp(2.6rem, 8vw, 4rem); font-weight: 300; letter-spacing: -0.035em; line-height: 1; }
  .lead { margin-top: var(--s5); font-size: 1.15rem; color: var(--muted); }
  section a { text-decoration: underline; text-decoration-color: var(--faint); }
  section a:hover { text-decoration-color: currentColor; }
  .reveal {
    font: inherit; font-size: 0.95rem; color: inherit; cursor: pointer;
    padding: 0.3rem 0.9rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface);
  }
  .reveal:hover { border-color: var(--accent); color: var(--accent); }
  .updated { margin-top: var(--s8); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-email]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const address = atob(btn.dataset.email!);
      const link = document.createElement('a');
      link.href = `mailto:${address}`;
      link.textContent = address;
      btn.replaceWith(link);
      link.focus();
    }),
  );
</script>
